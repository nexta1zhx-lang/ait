# bitcoooin.cn 的反代（Caddy 跑在 compose 里，所以用服务名 app 访问）
#
# 起法：docker compose -f docker-compose.prod.yml up -d --build
# 证书存在 caddy-data 卷里，容器重建不会重新申请，不会触发 Let's Encrypt 限流。
#
# 前置条件：
#   ① DNS：bitcoooin.cn 的 A 记录 → 52.194.6.144（已确认配好）
#   ② Lightsail 防火墙放行 80 / 443（控制台 → Networking → IPv4 Firewall）

# ================================================================
# 扫描器防护（2026-10-12）
#
# 现象：pan.bitcoooin.cn 一小时被打 1077 次，bitcoooin.cn 也被探
#   /wp-login.php、/wp-json/batch/v1、/.git/config、//…/cache.php —— 随机 UA 的
#   通用 CMS / 漏洞扫描，跟这两个站点实际用的技术栈毫无关系。
#   应用是 SPA（未知路径也回 index.html 200），扫描器会因此一直回来，
#   所以这里在 Caddy 层直接 403，不进应用。
#
# ⚠️ 只列**这两个站点不可能用到**的路径：动态脚本后缀 + wp-*/探针目录。
#    应用自己的 /api/* /assets/* /fonts/* /dl/* /diag* 一律不碰。
# ================================================================
(scanner-guard) {
	@scanner {
		path *.php *.php5 *.php7 *.phtml *.asp *.aspx *.jsp *.cgi
		path /wp-* /xmlrpc.php /wordpress/* /vendor/* /cgi-bin/* /setup.cgi
		path /.git/* /.svn/* /.hg/* /.env /.env.* /.aws/* /.ssh/* /.kube/*
		path /phpmyadmin* /pma* /adminer* /myadmin* /telescope/* /actuator/* /solr/*
		path /h5/* /api/user/ismustmobile /api/init
	}
	respond @scanner 403
}

bitcoooin.cn {
	encode gzip zstd
	# ---------------------------------------------------------------- 下载
	# APK / 安装包这类静态文件不走应用，Caddy 直接发文件。
	# 目录由 compose 挂进来：宿主机 ./downloads → 容器 /srv/dl
	# 链接形如 https://bitcoooin.cn/dl/xxx.apk
	# ⚠️ 必须是 handle_path（不是 handle）：handle_path 会把 `/dl` 前缀**剥掉**，
	# 所以 /dl/xxx.apk → /srv/dl/xxx.apk。
	# 用 handle 的话前缀不剥，会去找 /srv/dl/dl/xxx.apk —— 直接 404。
	handle_path /dl/* {
		root * /srv/dl
		file_server
	}

	# ---------------------------------------------------------------- 订阅（2026-10-12）
	# 订阅服务 /opt/sub_server.py **只监听 docker0 网关 172.17.0.1**，公网直连 2096
	# 已经不可达（旧版监听 0.0.0.0，被扫描器找到后连密钥一起端走了）。对外统一走
	# 这里，TLS 由本 Caddy 终止，复用 bitcoooin.cn 已有的证书。
	#
	# ⚠️ 鉴权**故意不写在这里**：BasicAuth 由订阅进程自己校验（凭据存 PBKDF2 哈希，
	#    在 /opt/subscription/users.json）。这样加/删用户只需要跑 `xray-user add <name>`，
	#    不用改这个文件、不用 reload Caddy。
	# ⚠️ 必须是 handle_path：/sub/clash → 订阅进程收到 /clash（同上面 /dl/* 的道理）。
	handle_path /sub/* {
		reverse_proxy host.docker.internal:2096
	}

	# ---------------------------------------------------------------- 其余全部给应用
	# ⚠️ handle 之间是**互斥**的（按路径长度挑最匹配的那条），
	# 所以这条兜底的必须是一个**不带头部**的 handle，不能再直接写 reverse_proxy。
	handle {
		# ⚠️ 必须写在兜底 handle **里面**：Caddy 会把 handle/handle_path 分成一组
		#    提前求值（实测编译后是 handle 组在前、站点顶层的 respond 在后），
		#    写在外面的话这条守卫轮不到执行（线上验证过：顶层的写法不生效）。
		import scanner-guard

		# 分析 / 提炼走 SSE（text/event-stream）。
		# flush_interval -1 = 每个事件立刻写出去，否则「分析过程」会憋到跑完才显示。
		reverse_proxy app:8787 {
			flush_interval -1
		}
	}

	# 访问日志走 stdout，用 docker compose logs caddy 看
	log {
		output stdout
		# ⚠️ 登录 token 会出现在 SSE 的 URL 里（EventSource 发不了请求头，只能走
		# `?token=`），原样记 = 把 token 明文写进日志。用 filter 编码器在写日志时
		# 把这个 query 参数抹掉。（`Authorization` 头 Caddy 本来就默认记成 REDACTED）
		format filter {
			wrap console
			request>uri query {
				replace token REDACTED
			}
		}
	}
}

# ---------------------------------------------------------------- 监控（可选）
# 起监控：docker compose -f docker-compose.prod.yml --profile monitor up -d
# 然后①在阿里云 DNS 加下面两条 A 记录（都指向 52.194.6.144）
# ②把下面这两段取消注释 ③docker compose -f docker-compose.prod.yml restart caddy
#
# ⚠️ 先加 DNS 再取消注释：域名解析不到，Caddy 申请证书会一直失败刷日志。
#
# status.bitcoooin.cn {
# 	reverse_proxy uptime-kuma:3001
# }
#
# logs.bitcoooin.cn {
# 	reverse_proxy dozzle:8080
# }




# ================================================================
# 自定义站点块（OpenList / RustDesk WSS）
# ⚠️ Caddyfile 是「服务器为准」：release.sh 已加 --exclude 排除它，
#    发布不会覆盖本文件。改完执行 sudo docker restart ca-caddy 生效。
# ================================================================

pan.bitcoooin.cn {
	encode gzip zstd

	# 扫描器探测（wp-* / .php / .git 这类）直接 403，别喂给应用
	import scanner-guard

	reverse_proxy host.docker.internal:5244 {
		transport http {
			read_timeout 1h
			write_timeout 1h
		}
		flush_interval -1
	}

	log {
		output stdout
	}
}

# ---------------------------------------------------------------- RustDesk Web 客户端 WSS
# 让浏览器里的 https://rustdesk.com/web 通过 WSS 连到本服务器。
#
# ⚠️ 代理目标不是 127.0.0.1:21118，而是 host 网络里的独立网关 21120。
#   原因：本 Caddy 跑在 docker bridge 网络，其 Go 反代连宿主机 host-network 服务
#   （hbbs/hbbr）时 WebSocket Upgrade 握手会失败（502 / 日志 msg=EOF）。
#   实测同配置换成 host 网络即返回 101。网关配置见 /opt/rustdesk-gw/Caddyfile。
rustdesk.bitcoooin.cn {
	# CORS：网页客户端 rustdesk.com 是跨域访问，必须回显，否则手机浏览器静默失败
	@cors header Origin https://rustdesk.com
	header @cors {
		Access-Control-Allow-Origin "https://rustdesk.com"
		Access-Control-Allow-Methods "OPTIONS,GET,POST"
		Access-Control-Allow-Headers "Origin, Content-Type, Accept, Authorization, Sec-WebSocket-Key, Sec-WebSocket-Version"
		Access-Control-Allow-Credentials "true"
	}

	@preflight method OPTIONS
	@ws {
		header Connection *Upgrade*
		header Upgrade websocket
	}

	# 连通性诊断页（手机排查用）
	route /diag* {
		redir /diag /diag/ 308
	}
	route /diag/* {
		rewrite * /diag.html
		root * /srv/dl
		file_server
	}

	# 全部用 route（handle 会被 Caddy 按路径长度重排，导致兜底块抢先匹配）
	route /ws/* {
		handle @preflight {
			respond 204
		}
		handle @ws {
			reverse_proxy host.docker.internal:21120
		}
		handle {
			header Content-Type "text/plain; charset=utf-8"
			respond "426 Upgrade Required" 426
		}
	}

	route {
		header Content-Type "text/plain; charset=utf-8"
		respond "RustDesk WSS endpoint OK

网页客户端: https://rustdesk.com/web
ID 服务器: rustdesk.bitcoooin.cn
Key: lLClWpEgqVs6D2uZhy+JEUZ2j7HGzFFGDoC+OOzKrR8=
" 200
	}
}
