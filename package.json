{
  "name": "crypto-entry-advisor",
  "version": "0.2.9",
  "private": true,
  "description": "币圈开单分析：拉行情 → 把 K 线读成文字 → 大模型预测最大概率的走法 + 形状标签概率",
  "bin": {
    "ca": "backend/dist/cli.js"
  },
  "scripts": {
    "dev": "tsx backend/src/cli.ts",
    "build": "npm run clean:backend && tsc -p backend/tsconfig.json",
    "start": "node backend/dist/cli.js",
    "web": "tsx backend/src/server.ts",
    "web:start": "NODE_ENV=production node backend/dist/server.js",
    "ui:dev": "vite --config frontend/vite.config.ts",
    "ui:dev:cloud": "API_TARGET=https://bitcoooin.cn vite --config frontend/vite.config.ts",
    "ui:build": "vite build --config frontend/vite.config.ts",
    "build:all": "npm run build && npm run ui:build",
    "typecheck": "tsc -p backend/tsconfig.json --noEmit",
    "selftest": "tsx backend/src/scripts/selftest.ts",
    "sync:contracts": "tsx backend/src/sync.ts",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f db",
    "db:status": "tsx backend/src/scripts/db.ts status",
    "db:reset": "tsx backend/src/scripts/db.ts reset",
    "prod:up": "docker compose -f docker-compose.prod.yml up -d --build",
    "prod:down": "docker compose -f docker-compose.prod.yml down",
    "prod:logs": "docker compose -f docker-compose.prod.yml logs -f app",
    "prod:backup": "docker compose -f docker-compose.prod.yml exec -T db pg_dump -U ca -d crypto_advisor -Fc > backup.dump",
    "release": "bash scripts/release.sh",
    "release:dry": "bash scripts/release.sh --dry-run",
    "deploy": "bash scripts/deploy.sh",
    "apk": "bash scripts/build-apk.sh",
    "swing": "tsx backend/src/scripts/swing.ts",
    "learn": "tsx backend/src/scripts/learn.ts",
    "history": "tsx backend/src/scripts/history.ts",
    "archive": "tsx backend/src/scripts/archive.ts",
    "cost": "tsx backend/src/scripts/cost.ts",
    "reprice": "tsx backend/src/scripts/reprice.ts",
    "peak": "tsx backend/src/scripts/peak.ts",
    "clean": "npm run clean:backend && npm run clean:frontend",
    "clean:backend": "rm -rf backend/dist",
    "clean:frontend": "rm -rf frontend/dist",
    "app:sync": "npm run ui:build && cap sync",
    "app:add:android": "cap add android",
    "app:add:ios": "cap add ios",
    "app:android": "npm run app:sync && cap open android",
    "app:ios": "npm run app:sync && cap open ios",
    "app:run:android": "npm run app:sync && cap run android",
    "app:run:ios": "npm run app:sync && cap run ios",
    "candles:seed": "tsx backend/src/scripts/seed-candles.ts",
    "candles:seed:vision": "tsx backend/src/scripts/seed-vision.ts",
    "candles:sync": "bash scripts/sync-candles.sh",
    "candles:partition": "tsx backend/src/scripts/migrate-candles-partitions.ts",
    "candles:audit": "tsx backend/src/scripts/audit-candles.ts"
  },
  "dependencies": {
    "ccxt": "^4.4.0",
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "echarts": "^6.1.0",
    "fflate": "^0.8.3",
    "lightweight-charts": "^5.2.1",
    "openai": "^4.77.0",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "vue": "^3.5.43",
    "vue-router": "^4.6.4",
    "ws": "^8.22.0",
    "yaml": "^2.6.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/status-bar": "^8.0.3",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-vue": "^5.2.4",
    "https-proxy-agent": "^9.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.4.3"
  },
  "engines": {
    "node": ">=18"
  }
}
