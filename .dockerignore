# 依赖与产物
# ⚠️ `backend/dist` / `frontend/dist` **故意不排除**（2026-10-07）：
#    release.sh 在本机构建好这两个目录随包发过来，镜像里 `PREBUILT=1` 就直接用它们
#    （省掉服务器上 111 秒的 tsc + vite）。PREBUILT=0 时 `build:all` 会自己覆盖，
#    不会出现新旧混着用的情况（`clean:backend` 先删、vite 也会清空 outDir）。
node_modules

# git 与本地历史（不进镜像）
.git
.gitignore

# 密钥绝不能进构建上下文 —— 否则会留在镜像层里
.env
.env.local
.env.*.local

# 运行产物
logs
*.log

# 下载目录（APK 有 4MB+，不往构建上下文里塞）——
# 它是 bind mount 进容器给 /api/downloads 读的，不是 COPY 进镜像的。
downloads

.DS_Store
