# 依赖
node_modules/

# 构建产物
backend/dist/
frontend/dist/

# 本地配置与密钥（绝不能提交）
.env
.env.local
.env.*.local

# 单实例锁（`backend/src/util/single-instance.ts` 运行时写的，本来就不该提交）
.dev-server.lock

# 下载分发目录里的大文件（目录本身要留着，Caddy 会挂它）
downloads/*.apk

# Firebase 的配置文件（**含 API key，绝不进 git**）：从 Firebase 控制台下载后
# 放到 android/app/google-services.json —— 没有它 Gradle 会跳过 google-services 插件，
# 推送就静默不生效（android/app/build.gradle 里那段 if 就是干这个的）
android/app/google-services.json

# Capacitor 原生工程的本地产物（原生工程源码仍然提交，见 docs/MOBILE.md）
android/app/src/main/assets/public/
android/.gradle/

# 运行产物
logs/
*.log
.DS_Store

# 币种图标的落盘缓存（backend 自己写的运行产物，见 server.ts 的「图标落盘」那段；
# `data/contracts.json` 是**要提交**的那份基准名单，别一起忽略）
data/icons/

# 市值排名的落盘缓存（backend 自己写的运行产物，见 data/marketcap.ts）——
# 免费接口会 429，所以最近一次成功的那份存盘、重启也带着；它是缓存不是基准，别提交
data/marketcap-ranks.json

# 编辑器本地配置（每个人那份不一样，不进仓库）
.vscode/

# 排查 K 线时临时扒下来的上游数据（`.tmp_kline/`：币安接口的原样返回，几十 MB）
.tmp_kline/
