# ============================================================
#  复制成 .env 后填自己的值：cp .env.example .env
# ============================================================

# ---- LLM 配置（OpenAI 兼容接口；目前按 DeepSeek 计价）----
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
# 也可在网页顶部直接切换（会写回这一行）
# 目前只有两个真实模型：deepseek-flash（便宜、够用）/ deepseek-v4-pro（更强、贵几十倍）
# 写 deepseek-chat / deepseek-reasoner 这类旧别名也能跑，读配置时会自动归一到上面两个
LLM_MODEL=deepseek-flash
# 温度：越低越稳定，建议 0~0.2
LLM_TEMPERATURE=0.1
# 思考力度：none | minimal | low | medium | high | auto
#
# 有些模型会把「思维链」写在隐藏字段里（deepseek-flash 就有），这部分
# 照样算 token、照样耗时，而代码只读最终内容，等于白花钱买一段思考。
# 实测同一道题：思考 1350/1626 tok（83%）、7477ms；关掉后 0 tok、2024ms，
# 正文反而更长。所以默认 none。
#   想要它想、但只快一点 → minimal
#   让模型自己决定        → auto（等于不传这个参数）
LLM_REASONING=none

# ---- 花费统计 ----
# 美元 → 人民币汇率，只影响展示（记录里存的是美元）
USD_CNY=7.1
# 单价覆盖（美元 / 1M token，填高峰价；低谷自动减半）
# 不填就按 backend/src/llm/pricing.ts 里的官方价目表算
# LLM_PRICE_INPUT_HIT=0.006
# LLM_PRICE_INPUT_MISS=0.3
# LLM_PRICE_OUTPUT=1.2

# ---- PostgreSQL（由 docker compose 起）----
# 启动数据库：npm run db:up
PGHOST=localhost
PGPORT=5432
PGUSER=ca
PGPASSWORD=ca_local_dev
PGDATABASE=crypto_advisor

# ---- 交易规则 ----
# 角色设定与规则正文存在数据库里，在网页「AI 提示词」页维护。
# 改完不用重启，每次分析自动重读；网页上不显示、也不编辑规则。

# ---- 交易所 ----
EXCHANGE=binance
# 市场类型：spot（现货）| swap（U 本位合约）| coinm（币本位合约）
MARKET_TYPE=swap
# 覆盖公共 API 域名（默认域名不可达时使用，如 https://data-api.binance.vision）
API_BASE=
