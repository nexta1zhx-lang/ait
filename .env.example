# ============================================================
#  复制成 .env 后填自己的值：cp .env.example .env
# ============================================================

# ---- LLM 配置（2026-10-04 起**不再放这里**）----
# Key / 接口地址 / 模型 / 思考力度改成**每个用户一份**（存数据库），
# 在网页「我的 → 模型配置」里填；管理员账号的配置由「管理」页查看。
# 服务器 .env 里原来那份会在首次启动时自动搬到管理员账号。
# 所以这里不再需要 LLM_API_KEY / LLM_BASE_URL / LLM_MODEL / LLM_TEMPERATURE，
# 也不需要 LLM_REASONING（思考力度在每个用户自己的配置里）。

# ---- 花费统计 ----
# 美元 → 人民币汇率，只影响展示（记录里存的是美元）
USD_CNY=7.1
# 单价覆盖（美元 / 1M token，填高峰价；低谷自动减半）
# 不填就按 backend/src/llm/pricing.ts 里的官方价目表算
# LLM_PRICE_INPUT_HIT=0.006
# LLM_PRICE_INPUT_MISS=0.3
# LLM_PRICE_OUTPUT=1.2

# ---- PostgreSQL（由 docker compose 起）----
# 启动数据库：npm run db:up
PGHOST=localhost
PGPORT=5432
PGUSER=ca
PGPASSWORD=ca_local_dev
PGDATABASE=crypto_advisor

# ---- 管理员账号（不在 .env 里）----
# ⚠️ 代码里**不再内置默认密码**（原先是写死的 admin / 123456，而仓库是公开的）。
# 管理员账号（用户名 + 密码哈希）随**本地数据库同步**一起上来 ——
# 部署流程里不需要任何「初始密码」，这里也没有对应变量。

# ---- 交易规则 ----
# 角色设定与规则正文存在数据库里，在网页「AI 提示词」页维护。
# 改完不用重启，每次分析自动重读；网页上不显示、也不编辑规则。

# ---- 交易所 ----
EXCHANGE=binance
# 市场类型：spot（现货）| swap（U 本位合约）| coinm（币本位合约）
MARKET_TYPE=swap
# 覆盖公共 API 域名（默认域名不可达时使用，如 https://data-api.binance.vision）
API_BASE=

# ---- 启动预热（后台跑，不挡启动）----
# 启动时把「成交额前 60 ∪ |24h 涨跌| > 20%」那批币的 K 线先取好，
# 这样点币种跳图不用等交易所（服务端命中 1~2ms）。
# 预热哪些周期 —— 每多一个，启动就多 60 次上游请求（约 +10s）。
# ⚠️ 没预热的周期：每个 (币,周期) 的**第一次**仍要现打交易所（~160ms，撞抖动 0.5~2s），
#    之后就常驻内存（已收盘的 K 线永不变），直到进程重启。
WARM_TFS=1h,15m

# ---- 数据保留 ----
# 「流水表」留多少天，超期自动删（每天跑一次）。**0 = 永不清理**。
# 只影响这两张「每做一次事就写一行」的表：
#   · analyses   每次分析的存档
#   · llm_usage  每次模型调用的 token / 花费
# 用户 2026-10-04：「流水数据永远不删吧」—— 所以**默认就是 0**。
# 要清理就显式写天数，例如 KEEP_DAYS=90（只留最近 3 个月）。
#
# ⚠️ 下面这些跟这个开关无关，**本来就永不删**：
#   · knowledge       一条条攒下来的经验案例
#   · tag_templates   标签模板
#   · contract_store  币种表（整份清单一行）
#   · ai_docs / ai_doc_versions  提示词（已废弃的旧机制，数据保留着）
KEEP_DAYS=0
